  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/fbr-di-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ]
  },

  "FbrApi": {
    "UseMockService": true,
    "DefaultEnvironment": "Sandbox",
    "TimeoutSeconds": 30,
    "RetryCount": 3
  },

  "AllowedHosts": "*"
