@{
    ViewData["Title"] = "Invoices";
}

<div class="space-y-5">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Invoices</h1>
            <p class="text-sm text-gray-500 mt-1">Manage and submit digital invoices to FBR</p>
        </div>
        <div class="flex gap-3">
            <button id="bulkSubmitBtn" class="btn-warning hidden">
                <i class="fa fa-paper-plane mr-2"></i>Bulk Submit (<span id="selectedCount">0</span>)
            </button>
            <a href="/Admin/Invoice/Create" class="btn-primary">
                <i class="fa fa-plus mr-2"></i>Create Invoice
            </a>
        </div>
    </div>

    <!-- Filters -->
    <div class="card">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div>
                <label class="form-label">From Date</label>
                <input type="date" id="filterFrom" class="form-input" />
            </div>
            <div>
                <label class="form-label">To Date</label>
                <input type="date" id="filterTo" class="form-input" />
            </div>
            <div>
                <label class="form-label">Status</label>
                <select id="filterStatus" class="form-input">
                    <option value="">All Statuses</option>
                    <option value="0">Draft</option>
                    <option value="1">Pending</option>
                    <option value="2">Submitted</option>
                    <option value="3">Valid</option>
                    <option value="4">Invalid</option>
                    <option value="5">Failed</option>
                </select>
            </div>
            <div class="flex items-end">
                <button onclick="reloadTable()" class="btn-primary w-full">
                    <i class="fa fa-filter mr-2"></i>Apply Filters
                </button>
            </div>
        </div>
    </div>

    <div class="card overflow-x-auto">
        <table id="invoicesTable" class="w-full text-sm" style="width:100%">
            <thead>
                <tr class="text-left text-gray-500 border-b border-gray-100">
                    <th class="pb-3 pr-3"><input type="checkbox" id="selectAll" class="h-4 w-4" /></th>
                    <th class="pb-3 font-medium pr-4">FBR Invoice#</th>
                    <th class="pb-3 font-medium pr-4">Date</th>
                    <th class="pb-3 font-medium pr-4">Buyer</th>
                    <th class="pb-3 font-medium pr-4">Grand Total</th>
                    <th class="pb-3 font-medium pr-4">Status</th>
                    <th class="pb-3 font-medium">Actions</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/invoice-list.js"></script>
}
