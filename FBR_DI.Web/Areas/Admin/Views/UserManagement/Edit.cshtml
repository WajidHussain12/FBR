@model EditUserViewModel
@{
    ViewData["Title"] = "Edit User";
}

<div class="max-w-2xl space-y-5">
    <div class="flex items-center gap-4">
        <a href="/Admin/UserManagement/Index" class="text-gray-400 hover:text-gray-600"><i class="fa fa-arrow-left"></i></a>
        <h1 class="text-2xl font-bold text-gray-900">Edit User</h1>
    </div>
    <div class="card">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />
            <div class="grid grid-cols-2 gap-4">
                <div><label asp-for="FirstName" class="form-label"></label><input asp-for="FirstName" class="form-input" /></div>
                <div><label asp-for="LastName" class="form-label"></label><input asp-for="LastName" class="form-input" /></div>
                <div class="col-span-2">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" type="email" class="form-input bg-gray-50" readonly />
                </div>
                <div>
                    <label asp-for="Role" class="form-label">Role</label>
                    <select asp-for="Role" asp-items="ViewBag.Roles" class="form-input"></select>
                </div>
                <div class="flex items-center gap-3 mt-6">
                    <input asp-for="IsActive" type="checkbox" class="h-4 w-4" />
                    <label asp-for="IsActive" class="form-label mb-0">Active</label>
                </div>
            </div>
            <div class="flex gap-3 pt-2">
                <button type="submit" class="btn-primary">Save Changes</button>
                <a href="/Admin/UserManagement/Index" class="btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
