@model RegisterViewModel
@{
    ViewData["Title"] = "Register User";
}

<div class="max-w-2xl space-y-5">
    <div class="flex items-center gap-4">
        <a href="/Admin/UserManagement/Index" class="text-gray-400 hover:text-gray-600">
            <i class="fa fa-arrow-left"></i>
        </a>
        <h1 class="text-2xl font-bold text-gray-900">Register New User</h1>
    </div>

    <div class="card">
        <form asp-action="Register" method="post" class="space-y-4">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="p-3 bg-red-50 border border-red-200 text-red-700 rounded-lg text-sm"></div>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label asp-for="FirstName" class="form-label"></label>
                    <input asp-for="FirstName" class="form-input" />
                    <span asp-validation-for="FirstName" class="text-red-500 text-xs"></span>
                </div>
                <div>
                    <label asp-for="LastName" class="form-label"></label>
                    <input asp-for="LastName" class="form-input" />
                </div>
                <div class="col-span-2">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" type="email" class="form-input" />
                    <span asp-validation-for="Email" class="text-red-500 text-xs"></span>
                </div>
                <div>
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" type="password" class="form-input" />
                    <span asp-validation-for="Password" class="text-red-500 text-xs"></span>
                </div>
                <div>
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" type="password" class="form-input" />
                </div>
                <div>
                    <label asp-for="Role" class="form-label">Role</label>
                    <select asp-for="Role" class="form-input">
                        <option value="Admin">Admin</option>
                        <option value="Manager">Manager</option>
                        <option value="Operator" selected>Operator</option>
                    </select>
                </div>
            </div>

            <div class="flex gap-3 pt-2">
                <button type="submit" class="btn-primary">Register User</button>
                <a href="/Admin/UserManagement/Index" class="btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
}
