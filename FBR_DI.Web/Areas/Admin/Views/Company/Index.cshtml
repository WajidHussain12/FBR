@{
    ViewData["Title"] = "Companies";
}

<div class="space-y-5">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold text-gray-900">Companies</h1>
            <p class="text-sm text-gray-500 mt-1">Manage registered companies and FBR integration</p>
        </div>
        <a href="/Admin/Company/Create" class="btn-primary">
            <i class="fa fa-plus mr-2"></i>Add Company
        </a>
    </div>

    <div class="card">
        <table id="companiesTable" class="w-full text-sm" style="width:100%">
            <thead>
                <tr class="text-left text-gray-500 border-b border-gray-100">
                    <th class="pb-3 font-medium pr-4">Company Name</th>
                    <th class="pb-3 font-medium pr-4">NTN</th>
                    <th class="pb-3 font-medium pr-4">Province</th>
                    <th class="pb-3 font-medium pr-4">Integration</th>
                    <th class="pb-3 font-medium pr-4">Environment</th>
                    <th class="pb-3 font-medium">Actions</th>
                </tr>
            </thead>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/company-list.js"></script>
}
