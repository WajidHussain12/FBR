@{
    ViewData["Title"] = "Reference Data";
}

<div class="space-y-5">
    <div>
        <h1 class="text-2xl font-bold text-gray-900">Reference Data</h1>
        <p class="text-sm text-gray-500 mt-1">FBR lookup data synced from the FBR API</p>
    </div>
    <div class="card">
        <p class="text-gray-500 text-sm">
            Use the <a href="/Admin/Company/Index" class="text-blue-600 underline">Company FBR Settings</a>
